APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

CARDCONNECT_SERVER=https://fts.cardconnect.com
CARDCONNECT_BILLING_MERCHANT_ID=your-billing-merchant-id
CARDCONNECT_BILLING_USERNAME=your-billing-username
CARDCONNECT_BILLING_PASSWORD=your-billing-password
CARDCONNECT_CRON_MERCHANT_ID=your-cron-merchant-id
CARDCONNECT_CRON_USERNAME=your-cron-username
CARDCONNECT_CRON_PASSWORD=your-cron-password

SENDGRID_API_KEY=your-sendgrid-api-key

# Optional Google Maps JavaScript API browser key (the script is not loaded when empty)
GOOGLE_MAPS_API_KEY=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Demo mode (see config/demo.php): payments are approved locally by the DemoGateway, mail is written
# to the log, PDF links point at this server and new registrations are verified automatically.
# Leave false in production. With true no CardConnect, mail or other external service is needed.
DEMO_MODE=false
